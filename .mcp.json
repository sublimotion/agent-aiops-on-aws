{
  "mcpServers": {
    "gpu-infra": {
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "/Users/phi/Documents/workbench/gpu-infra-troubleshooting/mcp-server",
        "gpu-infra-mcp"
      ],
      "env": {
        "SSH_KEY_PATH": "~/.ssh/gpu-cluster-key"
      }
    },
    "aws": {
      "command": "uvx",
      "args": [
        "mcp-proxy-for-aws@latest",
        "https://aws-mcp.us-east-1.api.aws/mcp",
        "--metadata",
        "AWS_REGION=us-west-2",
        "--read-only",
        "--log-level",
        "ERROR"
      ]
    }
  }
}
