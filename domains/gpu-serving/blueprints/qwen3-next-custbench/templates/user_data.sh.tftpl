#!/bin/bash
# GPU Node Bootstrap Script for Qwen3-Next on P5en
# Sets up: EKS join, kernel tuning, NVMe RAID0, FSx mount with client tuning
# No GDS (removed per spec — marginal gain, high complexity)
set -ex

# =============================================================================
# 1. EKS Bootstrap
# =============================================================================
/etc/eks/bootstrap.sh '${cluster_name}' \
  --kubelet-extra-args '--node-labels=nvidia.com/gpu.present=true,node.kubernetes.io/instance-type=p5en.48xlarge'

# =============================================================================
# 2. Lustre Kernel Module Tuning (takes effect on next module load/mount)
# Per AWS HyperPod FSx best practices for >64 vCPU instances
# =============================================================================
cat > /etc/modprobe.d/lustre-tuning.conf << 'MODPROBE'
options ptlrpc ptlrpcd_per_cpt_max=32
options ksocklnd credits=2560
MODPROBE

# =============================================================================
# 3. NVMe RAID0 Setup (P5en: 8x 3.84TB = ~30TB, ~25 GB/s read)
# Ephemeral local storage for fastest model loading
# =============================================================================
NVME_DEVS=$(lsblk -d -o NAME | grep -E '^nvme[1-9]' | awk '{print "/dev/"$1}' | xargs)
NVME_COUNT=$(echo $NVME_DEVS | wc -w)

if [ "$NVME_COUNT" -gt 0 ]; then
  # Stop any existing array
  mdadm --stop /dev/md0 2>/dev/null || true

  # Zero superblocks
  for dev in $NVME_DEVS; do
    mdadm --zero-superblock "$dev" 2>/dev/null || true
  done

  mdadm --create /dev/md0 --level=0 --raid-devices=$NVME_COUNT $NVME_DEVS --force
  mkfs.xfs -f /dev/md0
  mkdir -p /mnt/nvme
  mount -o noatime /dev/md0 /mnt/nvme
  echo "/dev/md0 /mnt/nvme xfs defaults,noatime 0 0" >> /etc/fstab
  echo "NVMe RAID0: $NVME_COUNT drives, $(df -h /mnt/nvme | tail -1 | awk '{print $2}') total"
fi

# =============================================================================
# 4. FSx Lustre Mount + Client Tuning
# =============================================================================
%{ if fsx_dns != "" ~}
yum install -y lustre-client || true
mkdir -p /mnt/fsx
mount -t lustre -o noatime,flock ${fsx_dns}@tcp:/${fsx_mount_name} /mnt/fsx
echo "${fsx_dns}@tcp:/${fsx_mount_name} /mnt/fsx lustre noatime,flock 0 0" >> /etc/fstab

# Post-mount Lustre client tuning (AWS HyperPod best practices)
# Write buffer
lctl set_param osc.*.max_dirty_mb=64

# Lock retention (for >64 GiB memory instances)
lctl set_param ldlm.namespaces.*.lru_max_age=600000
lctl set_param ldlm.namespaces.*.lru_size=$((100 * $(nproc)))

# Concurrent I/O RPCs
lctl set_param osc.*OST*.max_rpcs_in_flight=32

# Concurrent metadata RPCs
lctl set_param mdc.*.max_rpcs_in_flight=64
lctl set_param mdc.*.max_mod_rpcs_in_flight=50

echo "FSx mounted at /mnt/fsx with HyperPod client tuning applied"
%{ endif ~}

# =============================================================================
# 5. Persist tuning across reboots
# =============================================================================
%{ if fsx_dns != "" ~}
cat > /usr/local/bin/tune-lustre.sh << 'TUNE'
#!/bin/bash
# Re-apply Lustre client tuning after reboot
lctl set_param osc.*.max_dirty_mb=64 2>/dev/null
lctl set_param ldlm.namespaces.*.lru_max_age=600000 2>/dev/null
lctl set_param ldlm.namespaces.*.lru_size=$((100 * $(nproc))) 2>/dev/null
lctl set_param osc.*OST*.max_rpcs_in_flight=32 2>/dev/null
lctl set_param mdc.*.max_rpcs_in_flight=64 2>/dev/null
lctl set_param mdc.*.max_mod_rpcs_in_flight=50 2>/dev/null
TUNE
chmod +x /usr/local/bin/tune-lustre.sh
echo "@reboot /usr/local/bin/tune-lustre.sh" | crontab -
%{ endif ~}

echo "GPU node bootstrap complete"
