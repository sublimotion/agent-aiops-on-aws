# Phase 4 full stack — fill in `best_from_phase1/2/3` values after earlier phases complete
MODEL_PATH=/mnt/nvme/models/kimi-k26-fp8
DRAFT_PATH=/mnt/nvme/models/kimi-k26-eagle3
TP=8
MAX_MODEL_LEN=131072
GPU_MEM_UTIL=0.90

# EAGLE3 (replace with best config from Phase 1 or 2)
SPEC_NUM_STEPS=
SPEC_NUM_DRAFT_TOKENS=
SPEC_EAGLE_TOPK=

# HiCache
HICACHE_SIZE=200

# Dynamic MLA routing
ENABLE_DYNAMIC_MLA_ROUTING=1

# Engine winner (vllm | sglang)
ENGINE=
