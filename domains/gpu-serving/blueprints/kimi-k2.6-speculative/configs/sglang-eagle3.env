# SGLang EAGLE3 — Phase 1 baseline config
# Usage: docker run -v /mnt/nvme:/mnt/nvme --gpus all --network host --env-file configs/sglang-eagle3.env lmsysorg/sglang:v0.5.10-cu130
SGLANG_ENABLE_SPEC_V2=1
MODEL_PATH=/mnt/nvme/models/kimi-k26-fp8
DRAFT_PATH=/mnt/nvme/models/kimi-k26-eagle3
TP=8
# Phase 1 sweep parameters (edit per run, see spec Phase 1)
SPEC_NUM_STEPS=3
SPEC_NUM_DRAFT_TOKENS=4
SPEC_EAGLE_TOPK=1
