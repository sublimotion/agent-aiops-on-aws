# vLLM Phase 5 frontier — torch.compile + overlap + PP2xTP4 + NVFP4 variants.
# Each sub-phase overrides a subset of these.
MODEL_PATH=/mnt/nvme/models/kimi-k26-fp8
DRAFT_PATH=/mnt/nvme/models/kimi-k26-eagle3
TP=8
PP=1
MAX_MODEL_LEN=131072
GPU_MEM_UTIL=0.90
NUM_SPEC_TOKENS=4
# torch.compile level: 0=off, 1=basic, 2=moderate, 3=aggressive
COMPILATION_LEVEL=3
# Image — prefer stock vLLM latest. Phase 2 may provide a patched image.
IMAGE=vllm/vllm-openai:latest
